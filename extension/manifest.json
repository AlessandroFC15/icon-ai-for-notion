{
  "manifest_version": 3,
  "name": "Notion Icon AI",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Notion Icon AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://icon-ai-for-notion.icon-ai-for-notion-backend.workers.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://app.notion.com/*"],
      "js": ["notion.js", "strings.js", "popover.js", "content.js"],
      "css": ["content.css"]
    }
  ]
}
