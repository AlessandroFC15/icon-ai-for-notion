  "ratelimits": [
    { "name": "INSTALL_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ]
}
